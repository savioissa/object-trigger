{
  "name": "object-trigger",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0 <21 || >=22.12.0 <23"
  },
  "scripts": {
    "ng": "ng",
    "start": "concurrently -k -n gerador,angular \"npm:proto:observar\" \"ng serve\"",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "proto:gerar": "tsx src/app/prototipador/gerador/main.ts",
    "proto:observar": "tsx src/app/prototipador/gerador/main.ts --observar",
    "proto:planilha": "tsx src/app/prototipador/gerador/atualizar-planilha.ts",
    "proto:testar": "tsx --test src/app/prototipador/gerador/testes/*.test.ts",
    "prestart": "npm run proto:planilha && npm run proto:gerar",
    "prebuild": "npm run proto:planilha && npm run proto:gerar"
  },
  "dependencies": {
    "@angular/animations": "17.3.12",
    "@angular/common": "17.3.12",
    "@angular/compiler": "17.3.12",
    "@angular/core": "17.3.12",
    "@angular/forms": "17.3.12",
    "@angular/platform-browser": "17.3.12",
    "@angular/platform-browser-dynamic": "17.3.12",
    "@angular/router": "17.3.12",
    "@ngx-translate/core": "15.0.0",
    "@ngx-translate/http-loader": "8.0.0",
    "mermaid": "12.3.0",
    "primeflex": "^3.3.1",
    "primeicons": "7.0.0",
    "primeng": "17.18.15",
    "rxjs": "7.8.2",
    "tslib": "2.9.1",
    "zone.js": "0.14.10"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "17.3.17",
    "@angular/cli": "17.3.17",
    "@angular/compiler-cli": "17.3.12",
    "@types/jasmine": "5.1.15",
    "chokidar": "3.6.0",
    "concurrently": "10.0.7",
    "csv-parse": "7.0.3",
    "jasmine-core": "5.1.2",
    "karma": "6.4.4",
    "karma-chrome-launcher": "3.2.0",
    "karma-coverage": "2.2.1",
    "karma-jasmine": "5.1.0",
    "karma-jasmine-html-reporter": "2.1.0",
    "ts-morph": "28.0.0",
    "tsx": "4.23.15",
    "typescript": "5.4.5"
  }
}
